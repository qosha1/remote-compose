# Environment files — NEVER commit.
# Real credentials previously leaked via .django + .postgres bare files
# at repo root (history rewritten + creds rotated 2026-04-25). The old
# patterns `.django/` and `.postgres/` only matched DIRECTORIES, which
# is why bare files slipped through. New patterns cover both.
.django
.postgres
.django/
.postgres/
.env
.env.*
!.env.example
.envs/
**/.envs/
**/secrets.yml
**/secrets.yaml
*.env.local
*.env.production
*.env.staging
*.env.test-staging
*.env.secret

# Secrets and credentials — NEVER commit these
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.env
*.env.*
!*.env.example
.env.local
.env.production
.env.staging
secrets.yml
secrets.yaml
credentials.json
service-account*.json
*_rsa
*_dsa
*_ecdsa
*_ed25519
*.crt
*.cer

