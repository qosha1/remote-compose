{%- if existing_cluster %}
# Adopt a cluster a SHARED stack owns (startsim-wyn2). An ECS container instance
# registers to exactly ONE cluster, so packing several projects onto the same EC2
# instances requires them to share one. This project creates nothing cluster-scoped:
# not the cluster, not its capacity-provider association (which every adopter would
# otherwise fight over, each apply reverting the last), and not the ASG.
data "aws_ecs_cluster" "main" {
  cluster_name = var.cluster_name
}
{%- else -%}
resource "aws_ecs_cluster" "main" {
  name = var.cluster_name

  setting {
    name  = "containerInsights"
    value = "{{ 'enabled' if container_insights else 'disabled' }}"
  }
}

resource "aws_ecs_cluster_capacity_providers" "main" {
  cluster_name = aws_ecs_cluster.main.name

  capacity_providers = [
    "FARGATE",
    "FARGATE_SPOT",
{%- if has_ec2_service %}
    aws_ecs_capacity_provider.ec2.name,
{%- endif %}
  ]

  default_capacity_provider_strategy {
    capacity_provider = "FARGATE"
    weight            = 1
  }
}

{%- endif %}

resource "aws_cloudwatch_log_group" "tasks" {
  name              = "/ecs/${var.project}"
  retention_in_days = 30
}

{%- if container_insights %}
# ECS Container Insights auto-creates this log group on first task launch
# if it doesn't exist; declaring it here lets terraform manage its
# lifecycle so `rc destroy` actually removes it (otherwise the orphan
# log group keeps reappearing every redeploy).
#
# Only emitted when Container Insights is enabled. It's off by default
# (expensive CloudWatch metric ingestion, rarely worth it) — with it off
# AWS never creates this log group, so there is nothing to manage.
resource "aws_cloudwatch_log_group" "container_insights" {
  name              = "/aws/ecs/containerinsights/${var.cluster_name}/performance"
  retention_in_days = 14
}
{%- endif %}
