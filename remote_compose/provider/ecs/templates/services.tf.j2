{%- if has_build_context_service %}
# BuildKit registry-backed layer cache (rc-e5u.45.2). One shared repo per
# project; per-service cache lives at tag <svc>-cache. `docker buildx build
# --cache-from / --cache-to type=registry` reads/writes here so layer cache
# survives across machines + CI runs (a fresh laptop or CI runner gets the
# same cache the previous deploy populated). Untagged manifests expire
# after 7 days so the repo doesn't grow unbounded.
resource "aws_ecr_repository" "buildcache" {
  name                 = "${var.project}/buildcache"
  image_tag_mutability = "MUTABLE"
  force_delete         = true

  image_scanning_configuration {
    scan_on_push = false
  }
}

resource "aws_ecr_lifecycle_policy" "buildcache" {
  repository = aws_ecr_repository.buildcache.name

  policy = jsonencode({
    rules = [{
      rulePriority = 1
      description  = "Expire untagged BuildKit cache layers after 7 days"
      selection = {
        tagStatus   = "untagged"
        countType   = "sinceImagePushed"
        countUnit   = "days"
        countNumber = 7
      }
      action = { type = "expire" }
    }]
  })
}
{%- endif %}

{%- for svc in groups %}
{%- for c in svc.containers %}
{%- if c.owns_image_repo %}
resource "aws_ecr_repository" "{{ c.tf_name }}" {
  name                 = "${var.project}/{{ c.name }}"
  image_tag_mutability = "MUTABLE"
  force_delete         = true

  image_scanning_configuration {
    scan_on_push = true
  }
}
{%- endif %}
{%- endfor %}

resource "aws_ecs_task_definition" "{{ svc.tf_name }}" {
  family                   = "${var.project}-{{ svc.name }}"
  network_mode             = "{{ svc.network_mode }}"
  requires_compatibilities = ["{{ svc.launch_type }}"]
{%- if svc.launch_type != "EC2" %}
  cpu                      = "{{ svc.cpu }}"
{%- else %}
  # startsim-u88y: task-level cpu is OMITTED on EC2 deliberately. FARGATE
  # requires it, but on EC2 it is an optional HARD reservation held against the
  # container instance for the task's whole life -- and rc emits no
  # container-level cpu, so leaving it off means the task reserves none and
  # shares the instance's CPU instead. That sharing is the entire reason to
  # bin-pack on EC2.
  #
  # Measured on a real 33-task estate: 14.5 vCPU reserved against 0.88 vCPU p50
  # and a 5.18 vCPU true simultaneous peak. Carrying those reservations onto EC2
  # needed 15 instances (~$1023/mo) versus ~$526/mo of Fargate -- a 95%
  # REGRESSION. The bursts are real but uncorrelated: individual services peak at
  # 100% of their own reservation while the SUM never approaches it. Fargate
  # makes you buy peak-per-task; EC2 only pays if you buy peak-of-sum.
  #
  # memory below stays a task-level reservation on purpose -- it is the resource
  # that cannot be safely oversubscribed, and auto_size sizes the ASG from it.
{%- endif %}
  memory                   = "{{ svc.memory }}"
  execution_role_arn       = aws_iam_role.task_execution.arn
{%- if svc.declared_iam_role %}
  # Declared task role from rc.yml (`iam_roles.{{ svc.declared_iam_role }}`) instead of the
  # shared ${var.project}-task role, so this service holds only the grants
  # that role names, and none of the provider_config.ecs.iam ones. The comment
  # ends the aligned run above, so this line is unpadded on purpose: terraform
  # fmt aligns within a run, and a padded `=` here would be reformatted away.
  task_role_arn = {{ svc.task_role_ref }}
{%- else %}
  task_role_arn            = aws_iam_role.task.arn
{%- endif %}

  container_definitions = jsonencode([{% for c in svc.containers %}{
    name      = "{{ c.name }}"
{%- if c.has_build_context %}
    image     = "${aws_ecr_repository.{{ c.image_repo_tf_name }}.repository_url}:latest"
{%- elif c.compose_image %}
    image     = "{{ c.compose_image }}"
{%- else %}
    image     = "${aws_ecr_repository.{{ c.image_repo_tf_name }}.repository_url}:latest"
{%- endif %}
{%- if c.essential %}
    essential = true
{%- else %}
    # rc-m2sn: services.{{ c.name }}.essential = false. This container exiting
    # does NOT stop the task -- but ECS also never restarts an individual
    # container, so it stays dead and the task keeps running without it. That
    # is silent degradation, not the per-container restart a compose box gives
    # you. `rc plan` warns about it.
    essential = false
{%- endif %}
{%- if c.restart_policy %}
    # rc-ib01.4: restart THIS container in place instead of replacing the whole
    # task. Requires ECS container agent 1.86.0+ on EC2 (rc's AMI ships far
    # newer). Fixes TRANSIENT exits only -- a container that exits before
    # restartAttemptPeriod elapses is not restarted, and falls through to
    # whatever `essential` above says.
    restartPolicy = {
      enabled              = {{ 'true' if c.restart_policy.enabled else 'false' }}
{%- if c.restart_policy.ignored_exit_codes is defined and c.restart_policy.ignored_exit_codes %}
      ignoredExitCodes     = {{ c.restart_policy.ignored_exit_codes | tojson }}
{%- endif %}
{%- if c.restart_policy.attempt_period is defined and c.restart_policy.attempt_period %}
      restartAttemptPeriod = {{ c.restart_policy.attempt_period }}
{%- endif %}
    }
{%- endif %}
{%- if c.command %}
    command = {{ c.command | tojson }}
{%- endif %}
{%- if c.env %}
    environment = [
{%- for k, v in c.env.items() %}
      { name = "{{ k }}", value = "{{ v | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '$$') }}" }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{%- endif %}
{%- if c.port or c.extra_ports %}
    portMappings = [
{%- if c.port %}
      { containerPort = {{ c.port }}, protocol = "tcp" }{% if c.extra_ports %},{% endif %}
{%- endif %}
{%- for ep in c.extra_ports %}
      { containerPort = {{ ep }}, protocol = "tcp" }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{%- endif %}
{%- if c.mounts %}
    mountPoints = [
{%- for m in c.mounts %}
      {
        sourceVolume  = "{{ m.volume }}"
        containerPath = "{{ m.mount_path }}"
        readOnly      = false
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{%- endif %}
{%- if c.secrets %}
    secrets = [
{%- for sec in c.secrets %}
      {
        name      = "{{ sec.env_name }}"
        valueFrom = {{ sec.value_from_ref }}
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{%- endif %}
{%- if c.health_check %}
    # Container readiness check. With deployment_minimum_healthy_percent=100,
    # ECS keeps OLD tasks running until NEW ones pass this (not just reach
    # RUNNING) -- zero-downtime rolls for workers (no ALB) too.
    healthCheck = {
      command     = {{ c.health_check.command | tojson }}
      interval    = {{ c.health_check.interval }}
      timeout     = {{ c.health_check.timeout }}
      retries     = {{ c.health_check.retries }}
      startPeriod = {{ c.health_check.start_period }}
    }
{%- endif %}
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.tasks.name
        "awslogs-region"        = var.region
{%- if svc.containers | length > 1 %}
        # Per CONTAINER, not per task: this is what keeps `rc logs {{ c.name }}`
        # working for a member of a group -- it filters CloudWatch by the
        # stream prefix and never looks at the ECS service name.
{%- endif %}
        "awslogs-stream-prefix" = "{{ c.name }}"
      }
    }
  }{% if not loop.last %}, {% endif %}{% endfor %}])

{%- if svc.ephemeral_storage %}
  ephemeral_storage {
    size_in_gib = {{ svc.ephemeral_storage }}
  }
{%- endif %}

{%- for m in svc.mounts %}
  volume {
    name = "{{ m.volume }}"
    efs_volume_configuration {
      file_system_id     = {% if m.existing_fs_id %}"{{ m.existing_fs_id }}"{% else %}aws_efs_file_system.{{ m.volume_tf_name }}.id{% endif %}
      transit_encryption = "ENABLED"

      authorization_config {
        access_point_id = {% if m.existing_ap_id %}"{{ m.existing_ap_id }}"{% else %}aws_efs_access_point.{{ m.access_point_tf_name }}.id{% endif %}
        iam             = "{{ m.iam_auth }}"
      }
    }
  }
{%- endfor %}
{%- if ignore_task_definition_changes %}

  # container_definitions (image / env / secrets) are owned out-of-band for
  # this stack -- e.g. `rc deploy --no-state` force-rolls images and a secret
  # reconcile script wires SM secrets onto the live task def. Without this,
  # a stateful `terraform apply` would re-register a revision that reverts
  # those out-of-band changes (notably STRIPPING the reconciled secrets).
  lifecycle {
    ignore_changes = [container_definitions]
  }
{%- endif %}
}

resource "aws_ecs_service" "{{ svc.tf_name }}" {
  name            = "{{ service_name_prefix }}{{ svc.name }}"
  cluster         = {{ cluster_id_expr }}
  task_definition = aws_ecs_task_definition.{{ svc.tf_name }}.arn
  desired_count   = {{ svc.replicas }}
  # Required for `aws ecs execute-command` (rc exec / db backup / restore).
  # Task role carries ssmmessages:* perms (see iam.tf).
  enable_execute_command = true
{%- if svc.stateful %}
  # Service mounts EFS: stop the old task before starting the replacement,
  # otherwise two containers briefly share the same data directory and
  # stateful engines (postgres initdb) can wipe each other.
  deployment_minimum_healthy_percent = 0
  deployment_maximum_percent         = 100
  # Newer ECS APIs default availability_zone_rebalancing=ENABLED, which
  # actively redistributes tasks across AZs - the OPPOSITE of what a
  # stateful EFS-mounting workload wants (it deliberately keeps a single
  # task at a time on the data dir). The combo also gets rejected at
  # deploy time: "availability_zone_rebalancing does not support
  # maximumPercent <= 100". Pin it OFF for stateful services.
  availability_zone_rebalancing = "DISABLED"
{%- else %}
{%- if svc.deployment_overridden %}
  # Rollout percentages declared by rc.yml services.{{ svc.name }}.deployment,
  # in place of rc's zero-downtime default of 100/200. Below 100 minimum-
  # healthy, ECS takes serving capacity OUT to make room for replacements
  # instead of adding it: the roll is in-place, so nothing has to be sized for
  # a transient second copy of this service -- which is the point on EC2,
  # where "up to 200% for a few minutes" is what the ASG has to be big enough
  # to hold all month. The cost is a real dip while the roll runs, so this is
  # only sound for work that queues (a worker behind no ALB) rather than work
  # that is dropped. Circuit breaker still auto-rolls-back a bad deploy.
{%- else %}
  # Zero-downtime rolling deploy: keep 100% of old tasks running until the
  # NEW tasks pass their health check (or reach RUNNING if no healthCheck),
  # allowing up to 200% during the roll. Pair with a container healthCheck
  # (health_check:) so "healthy" means actually-ready -- otherwise ECS drains
  # old tasks the instant new ones reach RUNNING, before a worker can accept
  # work. Circuit breaker auto-rolls-back a deploy whose new tasks never go
  # healthy, instead of leaving a degraded/empty pool.
{%- endif %}
  deployment_minimum_healthy_percent = {{ svc.deployment_min_healthy_percent }}
  deployment_maximum_percent         = {{ svc.deployment_max_percent }}
  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }
{%- endif %}
{%- if svc.launch_type == "EC2" %}

  capacity_provider_strategy {
{%- if existing_cluster %}
    # The shared cluster stack owns this provider; reference it by name.
    capacity_provider = "{{ shared_capacity_provider }}"
{%- else %}
    capacity_provider = aws_ecs_capacity_provider.ec2.name
{%- endif %}
    weight            = 1
    base              = 1
  }

  # The AWS provider rejects any update to a service with
  # capacity_provider_strategy unless force_new_deployment is also true
  # ("force_new_deployment should be true when capacity_provider_strategy
  # is being updated") -- this fires on the very first apply that moves a
  # service from FARGATE onto EC2 capacity, since that's exactly a
  # capacity_provider_strategy change (launch_type -> capacity_provider_
  # strategy are mutually exclusive fields). Left on permanently rather
  # than only for that one transition: capacity_provider_strategy is a
  # tracked argument on this resource for the service's entire EC2-launch
  # lifetime, so any later change to it (rebalancing weight/base, e.g.)
  # would hit the identical error again.
  force_new_deployment = true

  # Bin-pack onto the fewest instances instead of ECS's default placement
  # (effectively random across eligible container instances). Without this,
  # EC2 launch type buys none of its cost advantage over Fargate -- tasks
  # spread thin, the ASG scales out to cover them, and you end up paying for
  # as many instances as Fargate would have run tasks. binpack by memory
  # (not cpu) because memory is the harder-to-overcommit resource on typical
  # web/worker containers; cpu bursts are usually fine to share.
  #
  # Trade-off: AZ rebalancing (ECS's automatic cross-AZ task redistribution)
  # only applies to services whose first (or only) placement strategy is an
  # AZ spread, or that declare none at all -- binpack-first makes this
  # service ineligible. Deliberate: bin-packing for density and spreading
  # for AZ resilience pull in opposite directions, and EC2 capacity here
  # optimizes for the former.
  ordered_placement_strategy {
    type  = "binpack"
    field = "memory"
  }
{%- if not svc.stateful %}

  # rc-5a4g: because rc asks for binpack above, it must also OWN this field.
  # ECS rejects the combination, so leaving the argument unrendered (the
  # AWS provider treats it as Optional+Computed and keeps whatever the live
  # service has) makes the outcome depend on history rather than on config:
  #
  #   CreateService with no value  -> ECS defaults to ENABLED
  #   UpdateService with no value  -> ECS keeps the service's existing value
  #                                   (API_CreateService, availabilityZoneRebalancing)
  #
  # So a service first created on FARGATE carries ENABLED, and the apply that
  # moves it to EC2 adds binpack while leaving ENABLED in place -- a config
  # that contradicts itself, and UpdateService 400s. Verified in the field on
  # debuggai-api: 6 of 7 services failed exactly this way, and the one that
  # migrated cleanly did so only because it is a singleton scheduler and had
  # therefore already been pinned DISABLED by the stateful branch above.
  # Same rc.yml, same apply, opposite outcomes -- which reads as flakiness
  # rather than as a config error, and is why rc must set this explicitly.
  #
  # Stateful services already pin it above (for the separate maximumPercent
  # <= 100 conflict); rendering it here too would be a duplicate argument.
  availability_zone_rebalancing = "DISABLED"
{%- endif %}
{%- else %}
  launch_type     = "FARGATE"
{%- if not svc.stateful and svc.deployment_max_percent <= 100 %}

  # rc-6akx: ECS rejects availability_zone_rebalancing alongside
  # maximumPercent <= 100 ("availability_zone_rebalancing does not support
  # maximumPercent <= 100"), and NOT rendering the argument does not mean
  # "off" -- CreateService defaults it to ENABLED and UpdateService keeps
  # whatever the live service already carries (see the EC2 branch above for
  # the field's full history). So a Fargate service that asks for an
  # in-place roll has to pin it explicitly, for the same reason the stateful
  # branch does. Only rendered when the percentages actually require it: a
  # service on the default 200% is emitted exactly as before.
  availability_zone_rebalancing = "DISABLED"
{%- endif %}
{%- endif %}

{%- if svc.network_mode == "awsvpc" %}

  network_configuration {
{%- if svc.declared_subnet_group or svc.declared_security_groups %}
    # Declared-network placement from rc.yml. Both knobs REPLACE rc's
    # defaults rather than adding to them.
{%- if svc.declared_subnet_group %}
    #   subnets: {{ svc.declared_subnet_group }} -- assign_public_ip follows that group's
    #     routing, so it cannot drift out of sync with it.
{%- endif %}
{%- if svc.declared_security_groups %}
    #   security_groups: {{ svc.declared_security_groups | join(', ') }} -- NOT joined to the shared
    #     ${var.project}-tasks group, so this task inherits neither its ALB
    #     ingress nor its blanket egress to 0.0.0.0/0.
{%- endif %}
{%- else %}
    # Fargate in public subnets with public IPs so tasks can pull images from
    # ECR without requiring a NAT gateway (~$0.045/hr saved). The tasks SG
    # only permits inbound from the ALB SG + self, so the public IP is not
    # an exposure - it is just an egress path. Declare `network.subnets` +
    # per-service `subnets:` for the private-subnet variant.
{%- endif %}
    subnets          = {{ svc.subnets_ref }}
    security_groups  = {{ svc.security_groups_ref }}
{%- if svc.launch_type != "EC2" %}
    assign_public_ip = {{ 'true' if svc.assign_public_ip else 'false' }}
{%- else %}
    # assign_public_ip is a FARGATE-only parameter -- the ECS CreateService
    # API rejects it outright for EC2 launch type ("Assign public IP is not
    # supported for this launch type"), confirmed against real AWS
    # (rc-e5u.25 cloud smoke). An EC2 task's ENI gets a public IP from the
    # SUBNET's own map_public_ip_on_launch instead (aws_subnet.public sets
    # this true; a declared network.subnets public group does too) -- same
    # outcome, different mechanism, no service-level knob needed.
{%- endif %}
  }
{%- else %}
  # rc-u122: networkMode "bridge" -- no network_configuration block. The
  # ECS API rejects one outright for any non-awsvpc mode ("Network
  # Configuration is not valid for the given networkMode"). The task
  # shares its container instance's ENI, so subnet, security group and
  # public IP are all properties of the INSTANCE, not of the task.
{%- endif %}

{%- if has_service_discovery %}
  service_registries {
    registry_arn = aws_service_discovery_service.{{ svc.tf_name }}.arn
  }
{%- endif %}

{%- if svc.public and svc.health_check_grace_period is not none %}
  # rc-05q: AWS default is 0s, which kills tasks before slow-booting
  # services (Django migrate + collectstatic + uvicorn) can bind. 60s
  # base; 180s when an auto_on_deploy lifecycle hook is declared.
  health_check_grace_period_seconds = {{ svc.health_check_grace_period }}
{%- endif %}
{%- if svc.public %}
  load_balancer {
{%- if svc.domain %}
    # service-specific TG attached via aws_lb_listener_rule (host-header)
    target_group_arn = aws_lb_target_group.{{ svc.tf_name }}.arn
{%- else %}
    target_group_arn = aws_lb_target_group.default.arn
{%- endif %}
    container_name   = "{{ svc.ingress_container }}"
    container_port   = {{ svc.port }}
  }

  depends_on = [{% if existing_alb %}aws_lb_listener_rule.{{ svc.tf_name }}{% else %}aws_lb_listener.http{% endif %}]
{%- endif %}
{%- if ignore_task_definition_changes %}

  # task_definition is owned out-of-band for this stack (reconcile script /
  # `rc deploy` force-roll register new revisions + repoint the service). Pair
  # with the task def's ignore_changes=[container_definitions] above: without
  # ignoring the SERVICE pointer too, every terraform apply REVERTS the service
  # back to terraform's own (stale, stripped-env) revision -- rolling the task
  # for nothing and, for single-task EFS services like postgres, opening a
  # Cloud Map DNS gap on every deploy.
  lifecycle {
    ignore_changes = [task_definition]
  }
{%- endif %}
}
{% endfor %}
