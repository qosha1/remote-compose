output "cluster_name" {
  value = aws_ecs_cluster.main.name
}

output "cluster_arn" {
  value = aws_ecs_cluster.main.arn
}

{%- if has_public_service %}
output "alb_dns_name" {
  value = aws_lb.main.dns_name
}
{%- endif %}

output "ecr_repositories" {
  value = {
{%- for svc in services %}
    "{{ svc.name }}" = aws_ecr_repository.{{ svc.tf_name }}.repository_url
{%- endfor %}
  }
}
