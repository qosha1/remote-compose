variable "project" {
  type        = string
  description = "Project name; tags and resource prefixes derive from this."
  default     = "{{ project }}"
}

variable "region" {
  type        = string
  description = "AWS region."
  default     = "{{ region }}"
}

variable "vpc_cidr" {
  type        = string
  description = "CIDR for the project VPC."
  default     = "{{ vpc_cidr }}"
}

variable "cluster_name" {
  type        = string
  description = "ECS cluster name."
  default     = "{{ cluster_name }}"
}
