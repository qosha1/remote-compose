{%- if has_service_discovery %}
# ------------------------------------------------------------------
# Cloud Map private DNS namespace for service-to-service discovery.
# Each service registers at {service_name}.{project}.local. DHCP
# options add the namespace to the resolver's search path so compose
# hostnames ("db", "cache") resolve without the FQDN.
# ------------------------------------------------------------------
{%- if not existing_cloud_map_namespace %}

resource "aws_service_discovery_private_dns_namespace" "main" {
  name = "${var.project}.local"
  vpc  = {{ vpc_id_ref }}
}
{%- endif %}
{%- if not existing_vpc %}

resource "aws_vpc_dhcp_options" "main" {
  domain_name         = "${var.project}.local"
  domain_name_servers = ["AmazonProvidedDNS"]
}

resource "aws_vpc_dhcp_options_association" "main" {
  vpc_id          = {{ vpc_id_ref }}
  dhcp_options_id = aws_vpc_dhcp_options.main.id
}
{%- endif %}

{%- for svc in groups %}
{%- if svc.containers | length > 1 %}
# rc-ib01: ONE registry for this whole task group. ECS allows exactly one
# service registry per ECS service ("Multiple service registries for each
# service isn't supported" -- CreateService), so these {{ svc.containers | length }} containers share
# ONE A record, at the GROUP's name. Reached at {{ svc.name }}.${var.project}.local on
# their own ports -- containers in an awsvpc task share one ENI, hence one IP,
# and rc validates that their ports do not collide.
#
# RETIRED by this grouping: {{ svc.retired_hostnames | join(', ') }}
# Those names no longer resolve. Anything that dialled them has to move to
# {{ svc.name }} + the right port.
{%- endif %}
resource "aws_service_discovery_service" "{{ svc.tf_name }}" {
  name = "{{ svc.name }}"

  dns_config {
    namespace_id = {{ service_discovery_namespace_ref }}
    dns_records {
      type = "A"
      ttl  = 10
    }
    routing_policy = "MULTIVALUE"
  }

  health_check_custom_config {
    failure_threshold = 1
  }
}
{%- endfor %}
{%- endif %}
