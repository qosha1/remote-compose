{%- if has_public_service %}
resource "aws_lb" "main" {
  name               = "${var.project}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = aws_subnet.public[*].id
}

{%- if not default_target_has_own_tg %}
resource "aws_lb_target_group" "default" {
  # rc-0zx: name_prefix + create_before_destroy so adding a service.domain
  # to an existing stack doesn't hit "Target group is currently in use by
  # a listener" during the listener-default-action move. AWS auto-suffixes
  # name_prefix with a unique 6-char id so two TGs can briefly coexist
  # while the listener cuts over.
  name_prefix = substr("${var.project}-", 0, 6)
  port        = {{ default_target_port }}
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "ip"

  health_check {
    path                = "{{ default_health_check_path }}"
    matcher             = "200-499"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
    timeout             = 5
  }

  lifecycle {
    create_before_destroy = true
  }
}
{%- endif %}

# When the default_target service has its own domain, its per-service TG
# acts as the default. Otherwise we emit a dedicated default TG above.
{%- if default_target_has_own_tg %}
locals {
  default_target_group_arn = aws_lb_target_group.{{ default_target_tf_name }}.arn
}
{%- else %}
locals {
  default_target_group_arn = aws_lb_target_group.default.arn
}
{%- endif %}

{%- if has_domain %}
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
{%- if tls_mode == "acm" %}
  certificate_arn   = aws_acm_certificate_validation.main.certificate_arn
{%- else %}
  certificate_arn   = "{{ certificate_arn }}"
{%- endif %}

  default_action {
    type             = "forward"
    target_group_arn = local.default_target_group_arn
  }
}

{%- for dsvc in domained_services %}

# Per-service target group for {{ dsvc.name }} (ALB host-based routing)
resource "aws_lb_target_group" "{{ dsvc.tf_name }}" {
  # rc-0zx: name_prefix + create_before_destroy — same rationale as the
  # default TG. Without this, adding/removing a domain to/from an
  # existing service hits the listener-rule in-use race.
  name_prefix = substr("${var.project}-{{ dsvc.tf_name }}-", 0, 6)
  port        = {{ dsvc.port }}
  protocol    = "HTTP"
  vpc_id      = aws_vpc.main.id
  target_type = "ip"

  health_check {
    path                = "{{ dsvc.health_check_path or '/' }}"
    matcher             = "200-499"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
    timeout             = 5
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_lb_listener_rule" "{{ dsvc.tf_name }}" {
  listener_arn = aws_lb_listener.https.arn
  priority     = {{ dsvc.listener_rule_priority }}

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ dsvc.tf_name }}.arn
  }

  condition {
    host_header {
      values = ["{{ dsvc.domain }}"]
    }
  }
}
{%- endfor %}
{%- else %}
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = local.default_target_group_arn
  }
}
{%- endif %}
{%- endif %}
