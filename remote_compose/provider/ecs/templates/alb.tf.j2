{%- if has_public_service %}
{%- if existing_alb %}
# Adopt-in-place: reference the existing ALB + its HTTPS listener. rc creates
# no aws_lb / listeners / alb security group; it only adds host-based listener
# rules + per-service target groups onto the existing listener below.
data "aws_lb" "main" {
  arn = "{{ existing_alb_arn }}"
}

data "aws_lb_listener" "https" {
  arn = "{{ existing_alb_https_listener_arn }}"
}
{%- else %}
resource "aws_lb" "main" {
  # AWS caps ALB names at 32 chars. "${project}-alb" overflows for long projects
  # (e.g. foundry-tenant-marketing-agents-alb = 35). Keep the readable name when it
  # fits (so existing ALBs never churn) and fall back to a deterministic
  # truncate+md5 name only when it would exceed the limit.
  name               = length("${var.project}-alb") <= 32 ? "${var.project}-alb" : "${substr(var.project, 0, 19)}-${substr(md5(var.project), 0, 8)}"
  internal           = false
  load_balancer_type = "application"
  security_groups    = {{ alb_security_groups_ref }}
  subnets            = {{ public_subnet_ids_ref }}
  # Connection idle timeout (provider_config.ecs.idle_timeout; default 60 = AWS
  # default). Raise for long-lived connections (WebSockets/SSE/streaming) so the
  # LB doesn't drop the socket mid-stream.
  idle_timeout       = {{ alb_idle_timeout }}
{%- if adopt_owned_alb %}

  # Adopted from a foreign stack (provider_config.ecs.adopt_owned.alb) —
  # imported via terraform import, not created here. rc owns this ALB's
  # lifecycle (update/destroy authority) but deliberately never diffs its
  # live attributes against what rc would render from scratch: the name
  # above almost never matches the adopted ALB's real name, and forcing it
  # would replace (destroy) a traffic-serving ALB.
  lifecycle {
    ignore_changes = all
  }
{%- endif %}
}

{%- if not default_target_has_own_tg %}
resource "aws_lb_target_group" "default" {
  # rc-0zx: name_prefix + create_before_destroy so adding a service.domain
  # to an existing stack doesn't hit "Target group is currently in use by
  # a listener" during the listener-default-action move. AWS auto-suffixes
  # name_prefix with a unique 6-char id so two TGs can briefly coexist
  # while the listener cuts over.
  name_prefix = substr("${var.project}-", 0, 6)
  port        = {{ default_target_port }}
  protocol    = "HTTP"
  vpc_id      = {{ vpc_id_ref }}
  target_type = "ip"

  health_check {
    path                = "{{ default_health_check_path }}"
    matcher             = "200-499"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
    timeout             = 5
  }

  lifecycle {
    create_before_destroy = true
  }
}
{%- endif %}

# When the default_target service has its own domain, its per-service TG
# acts as the default. Otherwise we emit a dedicated default TG above.
{%- if default_target_has_own_tg %}
locals {
  default_target_group_arn = aws_lb_target_group.{{ default_target_tf_name }}.arn
}
{%- else %}
locals {
  default_target_group_arn = aws_lb_target_group.default.arn
}
{%- endif %}
{%- endif %}

{%- if has_domain %}
{%- if not existing_alb %}
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
{%- if adopt_owned_alb %}

  lifecycle {
    ignore_changes = all
  }
{%- endif %}
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.main.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
{%- if tls_mode == "acm" %}
  certificate_arn   = aws_acm_certificate_validation.main.certificate_arn
{%- else %}
  certificate_arn   = "{{ certificate_arn }}"
{%- endif %}

  default_action {
    type             = "forward"
    target_group_arn = local.default_target_group_arn
  }
{%- if adopt_owned_alb %}

  lifecycle {
    ignore_changes = all
  }
{%- endif %}
}
{%- endif %}

{%- for dsvc in domained_services %}

# Per-service target group for {{ dsvc.name }} (ALB host-based routing)
resource "aws_lb_target_group" "{{ dsvc.tf_name }}" {
  # rc-0zx: name_prefix + create_before_destroy — same rationale as the
  # default TG. Without this, adding/removing a domain to/from an
  # existing service hits the listener-rule in-use race.
  name_prefix = substr("${var.project}-{{ dsvc.tf_name }}-", 0, 6)
  port        = {{ dsvc.port }}
  protocol    = "HTTP"
  vpc_id      = {{ vpc_id_ref }}
  target_type = "ip"

  health_check {
    path                = "{{ dsvc.health_check_path or '/' }}"
    matcher             = "200-499"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 30
    timeout             = 5
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_lb_listener_rule" "{{ dsvc.tf_name }}" {
  listener_arn = {{ https_listener_ref }}
  priority     = {{ dsvc.listener_rule_priority }}

  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.{{ dsvc.tf_name }}.arn
  }

  condition {
    host_header {
      values = ["{{ dsvc.domain }}"]
    }
  }
}
{%- endfor %}
{%- if existing_alb and tls_mode == "acm" %}

# rc-4tkc: when the listener is ADOPTED, rc emits no aws_lb_listener, so the
# certificate it just minted has nowhere to bind — `certificate_arn` only exists
# on the listener resource rc is deliberately not creating. Without this the cert
# is requested, DNS-validated and then never attached, and TLS to the service's
# domain serves whatever DEFAULT certificate the adopted listener carries: a name
# mismatch the client sees as an invalid certificate.
#
# Attaching it as an SNI certificate is what makes several projects share one
# ALB — each contributes its own host-based rule (above) AND its own cert here.
#
# ACM mode only, on purpose. In manual mode the operator supplied a
# certificate_arn for a listener they already own, and that cert is typically
# that listener's DEFAULT — AWS rejects adding a listener's default certificate
# to it again as an SNI cert. Leaving manual mode untouched also keeps the
# emitted terraform byte-identical for the original adopt-in-place user.
resource "aws_lb_listener_certificate" "main" {
  listener_arn    = {{ https_listener_ref }}
  certificate_arn = aws_acm_certificate_validation.main.certificate_arn
}
{%- endif %}
{%- else %}
{%- if not existing_alb %}
resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = local.default_target_group_arn
  }
{%- if adopt_owned_alb %}

  lifecycle {
    ignore_changes = all
  }
{%- endif %}
}
{%- endif %}
{%- endif %}
{%- endif %}
