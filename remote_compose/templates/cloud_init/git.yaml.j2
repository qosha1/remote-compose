#cloud-config
package_update: true
package_upgrade: false
packages:
  - docker
  - ncurses-term
  - git
  - tmux
  - jq

write_files:
  # Bootstrap script in /usr/local/bin (always writable as root, no
  # ec2-user dependency). Avoids the cloud-init race where /home/ec2-user
  # might not be ec2-user-owned at write_files time on AL2023.
  - path: /usr/local/bin/rc-dev-bootstrap.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail
      # Ensure ec2-user owns its home (cloud-init sometimes leaves it root-owned)
      chown -R ec2-user:ec2-user /home/ec2-user
      # Move staged env file (written via cloud-init write_files in /tmp) into place
      if [ -f /tmp/rc-dev-env-staging ]; then
        cp /tmp/rc-dev-env-staging /home/ec2-user/.rc-dev-env
        chown ec2-user:ec2-user /home/ec2-user/.rc-dev-env
        chmod 0600 /home/ec2-user/.rc-dev-env
        rm -f /tmp/rc-dev-env-staging
      fi
      cd /home/ec2-user
      # Source env (GH_TOKEN, ANTHROPIC_API_KEY, etc.) if present
      if [ -f /home/ec2-user/.rc-dev-env ]; then
        set -a && source /home/ec2-user/.rc-dev-env && set +a
      fi
{%- if expects_secrets %}
      # Secrets (GH_TOKEN, ANTHROPIC_API_KEY, ...) are deliberately NOT in
      # user-data. That blob is readable from this box's own IMDS by any
      # process on it, readable off the box with ec2:DescribeInstanceAttribute,
      # and terraform serializes it verbatim into terraform.tfvars.json and
      # terraform.tfstate. The CLI delivers them over SSH once sshd answers
      # (rc dev up -> _deliver_secret_env), so block here until they land --
      # the clone below is the first thing that needs the PAT.
      #
      # Bounded wait: if delivery never happens we fall through and attempt an
      # unauthenticated clone, which fails loudly on a private repo rather than
      # hanging the boot forever.
      for _ in $(seq 1 60); do
        [ -f /tmp/rc-dev-secrets ] && break
        sleep 5
      done
      if [ -f /tmp/rc-dev-secrets ]; then
        cat /tmp/rc-dev-secrets >> /home/ec2-user/.rc-dev-env
        chown ec2-user:ec2-user /home/ec2-user/.rc-dev-env
        chmod 0600 /home/ec2-user/.rc-dev-env
        # The staged copy has served its purpose; the 0600 file in $HOME is
        # the single on-box home for it.
        shred -u /tmp/rc-dev-secrets 2>/dev/null || rm -f /tmp/rc-dev-secrets
        set -a && source /home/ec2-user/.rc-dev-env && set +a
      else
        echo "rc-dev: WARNING - secrets never arrived over SSH; private clones will fail" >&2
      fi
{%- endif %}
      # Never persist the PAT. Cloning with the token in the URL leaves it in
      # .git/config on every repo, world-readable to anything on the box, and
      # tools copy it onward — beads lifts the remote URL verbatim into its own
      # config, so a live gho_ token ends up in a second file nobody thinks to
      # check. Instead: reset origin to the clean URL and answer git's auth
      # prompts from $GH_TOKEN in the environment, which is already present via
      # .rc-dev-env. Nothing secret touches disk.
      sudo -u ec2-user git config --global credential.helper '!f() { echo username=x-access-token; echo password=$GH_TOKEN; }; f'
      # Clone with optional GH token (set via SSM-injected env or runcmd export)
      if [ -n "${GH_TOKEN:-}" ]; then
        sudo -u ec2-user GH_TOKEN="${GH_TOKEN}" git clone "https://x-access-token:${GH_TOKEN}@github.com/{{ url | replace('https://github.com/', '') }}" {{ repo_name }}
      else
        sudo -u ec2-user git clone {{ url }} {{ repo_name }}
      fi
      cd {{ repo_name }}
      sudo -u ec2-user git checkout {{ ref }} || sudo -u ec2-user git checkout -b {{ ref }}
      sudo -u ec2-user git remote set-url origin {{ url }}
      # Place any env files staged by `rc dev up --env <file>` into their
      # original cwd-relative paths under /home/ec2-user/. Done HERE (after
      # clone+checkout) to avoid pre-creating subdirs that block clone.
      if [ -d /tmp/rc-dev-envs ]; then
        shopt -s dotglob nullglob
        for staged in /tmp/rc-dev-envs/*; do
          [ -f "$staged" ] || continue
          name=$(basename "$staged")
          rel=$(echo "$name" | sed 's|__|/|g')
          target=/home/ec2-user/$rel
          mkdir -p "$(dirname $target)"
          cp "$staged" "$target"
          chown ec2-user:ec2-user "$target"
        done
        shopt -u dotglob nullglob
      fi
      # Final ownership sweep — defends against the race where post-boot SCP
      # ops landed root-owned files in the home dir (rc-7v6).
      chown -R ec2-user:ec2-user /home/ec2-user
      # Try the common compose file names — first match wins.
      # Record the exit status to .rc-dev-compose-status so `rc dev up --wait`
      # can report a compose failure instead of leaving the user to discover
      # later that their services never started.
      : > /home/ec2-user/.rc-dev-compose-status
      for f in docker-compose.yml local.yml compose.yml docker-compose.local.yml; do
        if [ -f "$f" ]; then
          project=$(basename "$f" .yml | sed 's/^docker-compose\.//' | sed 's/[^a-zA-Z0-9]/-/g')
          log="/home/ec2-user/rc-dev-compose-$project.log"
          # tee keeps the build streaming into cloud-init-output.log while also
          # capturing it; pipefail (set above) makes the pipeline carry compose's
          # exit status rather than tee's.
          if docker compose -f "$f" up -d --build 2>&1 | tee "$log"; then
            st=0
          else
            st=$?
            echo "ERROR: compose project '$project' FAILED (exit $st) — see $log" >&2
          fi
          printf '%s\t%s\n' "$project" "$st" >> /home/ec2-user/.rc-dev-compose-status
          break
        fi
      done
      chown ec2-user:ec2-user /home/ec2-user/.rc-dev-compose-status 2>/dev/null || true
      chown ec2-user:ec2-user /home/ec2-user/rc-dev-compose-*.log 2>/dev/null || true

  - path: /usr/local/bin/rc-dev-start-claude.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/bash
      # Start claude in a detached tmux session ec2-user can attach to.
      cd /home/ec2-user/{{ repo_name }} 2>/dev/null || cd /home/ec2-user
      if [ -f /home/ec2-user/.rc-dev-env ]; then
        set -a && source /home/ec2-user/.rc-dev-env && set +a
      fi
      # This script runs from cloud-init, i.e. under systemd, whose default TERM
      # is vt220. Without clearing it the tmux SERVER stores TERM=vt220 in its
      # global environment and every process started in a pane inherits it — so
      # the claude TUI believes it is driving a 1983 terminal and falls back to
      # ACS line-drawing, which renders as stray letters and symbols all over
      # the UI. tmux renders the pane as tmux-256color meanwhile, so the two
      # disagree. Unset it and let tmux assign the pane TERM from
      # default-terminal.
      unset TERM
      # AL2023 ships no LANG at all, so the process lands in the POSIX/C locale
      # and UTF-8 box-drawing/glyphs come out as mojibake. C.utf8 is always
      # present on this AMI.
      export LANG="${LANG:-C.UTF-8}"
      export LC_ALL="${LC_ALL:-C.UTF-8}"
      # tmux hardening lives in /home/ec2-user/.tmux.conf (a write_files entry
      # below). AL2023's tmux 3.2a SEGFAULTS the whole server in
      #   cmd_load_buffer_done -> tty_set_selection -> tty_putcode_ptr2
      # when a clipboard write (`load-buffer -w`, which the claude TUI does)
      # reaches a client whose terminal advertises the Ms (OSC-52) capability.
      # That is exactly what happens when a human attaches from a normal
      # terminal: the display garbles and EVERY session on the box dies, so
      # `rc dev attach` afterwards has nothing to attach to.
      #
      # claude warns "~/.local/bin/claude missing or broken" on every start
      # because npm installs it elsewhere and that dir does not exist. Resolve
      # the real target BEFORE linking: once ~/.local/bin is on PATH,
      # `command -v claude` finds the link itself and it self-references.
      real_claude="$(command -v claude || true)"
      case "$real_claude" in
        /home/ec2-user/.local/bin/claude|"") real_claude=/usr/bin/claude ;;
      esac
      mkdir -p /home/ec2-user/.local/bin
      ln -sf "$real_claude" /home/ec2-user/.local/bin/claude
      # Clipboard policy depends on the tmux actually present. 3.2a segfaults
      # the server in the OSC-52 path and the only workaround is stripping Ms,
      # which is exactly what disables copy. >= 3.3 has no such bug, so the
      # clipboard stays fully on. Sourced fragment keeps ~/.tmux.conf static.
      tmux_ver="$(tmux -V | awk '{print $2}' | tr -d 'a-z')"
      if [ "$(printf '%s\n3.3\n' "$tmux_ver" | sort -V | head -1)" = "3.3" ]; then
        printf '%s\n' '# tmux >= 3.3: no segfault, OSC-52 on, selections reach the local clipboard.' 'set -g set-clipboard on' > /home/ec2-user/.tmux.clipboard.conf
      else
        printf '%s\n' '# tmux 3.2a SAFE MODE: stripping Ms is the only way to stop the server' '# segfaulting on a clipboard write, at the cost of copy-to-clipboard.' 'set -ga terminal-overrides ",*:Ms@"' 'set -g set-clipboard off' > /home/ec2-user/.tmux.clipboard.conf
      fi
      chown ec2-user:ec2-user /home/ec2-user/.tmux.clipboard.conf 2>/dev/null || true
      tmux kill-session -t claude 2>/dev/null || true
      # -x/-y so a detached-created session is not pinned at 80x24, which
      # renders garbage when attached from a normal-size terminal.
      # --continue: resumes the most recent conversation for this directory
      # if one exists (stop/start, Spot interruption). The box surviving a
      # stop is only half the story without this — the relaunched agent
      # otherwise has no memory of what it was doing even though the code on
      # disk is untouched.
      #
      # `|| claude {{ claude_flags }}` fallback is load-bearing, not
      # defensive filler: measured live, `claude --continue` in interactive
      # mode can exit 1 ("No deferred tool marker found in the resumed
      # session" — seen on a box whose copied ~/.claude.json carried a stale
      # deferred-tool reference), and a command that exits non-zero as a
      # detached tmux pane's sole process kills the pane, the window, and
      # the whole tmux SERVER with it — `rc dev attach` then has nothing to
      # attach to at all. The fallback keeps a session launching even when
      # resuming fails for any reason.
      tmux new-session -d -s claude -x 220 -y 50 "cd /home/ec2-user/{{ repo_name }} 2>/dev/null || cd /home/ec2-user; claude --continue {{ claude_flags }} || claude {{ claude_flags }}"
      # Clear the one-time "Do you trust this folder?" dialog. Without this,
      # `rc dev attach` drops you on a modal prompt rather than a usable agent —
      # which contradicts the "attach lands ready" promise `up` prints. The
      # sleep lets the TUI finish its first paint before the keystroke lands.
      sleep 6
      tmux send-keys -t claude "1" Enter
      echo "claude tmux session started — attach with: tmux attach -t claude"

  - path: /home/ec2-user/.tmux.conf
    permissions: '0644'
    # NO `owner:` here. write_files runs before the ec2-user account exists, so
    # naming it aborts the ENTIRE module with
    #   ('write-files', OSError('Unknown user or group: getpwnam(): name not
    #    found: ec2-user'))
    # which fails cloud-init outright — no clones, no compose, no box. It lands
    # root-owned; rc-dev-bootstrap.sh's `chown -R ec2-user:ec2-user
    # /home/ec2-user` (its first action) fixes ownership before anything reads it.
    content: |
      # Avoid the tmux 3.2a tty_set_selection segfault documented in
      # rc-dev-start-claude.sh: stripping Ms keeps tmux out of the crashing
      # OSC-52 path. set-clipboard off does NOT cover it (load-buffer -w
      # bypasses that option), so the override is the load-bearing line.
      # Clipboard policy is version-dependent — see rc-dev-start-claude.sh.
      source-file -q ~/.tmux.clipboard.conf
      # A session created with `new-session -d` is pinned to its creation
      # geometry; attaching from a different-size terminal then renders garbage
      # until something forces a resize.
      set -g window-size latest
      setw -g aggressive-resize on
      # The claude TUI asks for this explicitly on startup.
      set -g focus-events on
      set -g default-terminal "tmux-256color"
      set -g history-limit 50000
      set -g mouse on
      # With mouse on a drag selects into tmux's buffer; pipe it to the system
      # clipboard on release so a normal drag actually copies.
      bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel
      bind -T copy-mode    MouseDragEnd1Pane send -X copy-pipe-and-cancel

  - path: /etc/profile.d/rc-dev-locale.sh
    permissions: '0644'
    content: |
      # AL2023 ships no LANG, so an interactive ssh session lands in the
      # POSIX/C locale and renders UTF-8 output as mojibake. C.utf8 is always
      # present on this AMI.
      export LANG="${LANG:-C.UTF-8}"
      export LC_ALL="${LC_ALL:-C.UTF-8}"

  - path: /etc/profile.d/rc-dev.sh
    permissions: '0644'
    content: |
      export RC_DEV_REPO_URL="{{ url }}"
      export RC_DEV_REPO_REF="{{ ref }}"
      export RC_DEV_REPO_DIR="/home/ec2-user/{{ repo_name }}"
      # Source rc-dev-env so GH_TOKEN, ANTHROPIC_API_KEY etc. are in the
      # interactive shell. Lets `gh repo clone`, `gh pr`, etc. work without
      # the user re-authing in the box.
      if [ -f "$HOME/.rc-dev-env" ]; then
        set -a && . "$HOME/.rc-dev-env" && set +a
      fi
      cd "$RC_DEV_REPO_DIR" 2>/dev/null || true
{% if has_env %}
  # Write to /tmp first — /home/ec2-user might not be ec2-user-owned at
  # write_files time. Bootstrap script copies + chowns it after fixing perms.
  - path: /tmp/rc-dev-env-staging
    permissions: '0600'
    owner: root:root
    content: |
{{ rc_dev_env_content | indent(6, True) }}
{% endif %}

runcmd:
  # A t4g.large running the full stack sits at ~90% memory with ZERO swap, and
  # AL2023 provisions none. Under pressure the kernel thrashes in reclaim rather
  # than OOM-killing anything, so the box goes UNREACHABLE while looking healthy
  # from AWS: status checks ok, CPU credits fine, TCP accepted on :22, but sshd
  # can never fork and the SSH banner never arrives. Observed exactly that — and
  # zero OOM kills in the journal, which is what makes it so confusing to
  # diagnose. Swap turns "unreachable" into merely "slow".
  - 'if ! swapon --show | grep -q .; then fallocate -l 4G /swapfile; chmod 600 /swapfile; mkswap /swapfile >/dev/null 2>&1; swapon /swapfile; if ! grep -q "^/swapfile" /etc/fstab; then echo "/swapfile none swap sw 0 0" >> /etc/fstab; fi; fi; swapon --show'
  - systemctl enable --now docker
  - usermod -aG docker ec2-user
  - mkdir -p /usr/local/lib/docker/cli-plugins
  - curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-{{ docker_arch }}" -o /usr/local/lib/docker/cli-plugins/docker-compose
  - chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  # Node 20 + Claude Code agent CLI
  - curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
  - dnf install -y nodejs
  - npm install -g @anthropic-ai/claude-code
  # bd (beads) — issue tracker the local Claude session expects (settings.json
  # SessionStart hook calls 'bd prime'). v1.0.3 pinned for reproducibility.
  - 'arch=$(uname -m); case "$arch" in aarch64) bd_arch=arm64 ;; x86_64) bd_arch=amd64 ;; *) bd_arch="" ;; esac; if [ -n "$bd_arch" ]; then curl -sL "https://github.com/steveyegge/beads/releases/download/v1.0.3/beads_1.0.3_linux_${bd_arch}.tar.gz" | tar -xz -C /usr/local/bin bd && chmod +x /usr/local/bin/bd; fi'
  # gh CLI — picks up $GH_TOKEN from the rc-dev-env file (sourced by
  # /etc/profile.d/rc-dev.sh on shell start), so 'gh repo clone' / 'gh pr'
  # work without re-authing in the box. v2.92.0 pinned for reproducibility.
  - 'arch=$(uname -m); case "$arch" in aarch64) gh_arch=arm64 ;; x86_64) gh_arch=amd64 ;; *) gh_arch="" ;; esac; if [ -n "$gh_arch" ]; then dnf install -y "https://github.com/cli/cli/releases/download/v2.92.0/gh_2.92.0_linux_${gh_arch}.rpm"; fi'
  # dolt — version-controlled SQL database backing beads' remote-sync state
  # ('bd dolt push'/'bd dolt pull'). v2.2.3 pinned for reproducibility.
  - 'arch=$(uname -m); case "$arch" in aarch64) dolt_asset=dolt-linux-arm64.tar.gz ;; x86_64) dolt_asset=dolt-linux-amd64.tar.gz ;; *) dolt_asset="" ;; esac; if [ -n "$dolt_asset" ]; then dolt_dir="${dolt_asset%.tar.gz}"; curl -sL "https://github.com/dolthub/dolt/releases/download/v2.2.3/${dolt_asset}" | tar -xz -C /tmp && install -m 0755 "/tmp/${dolt_dir}/bin/dolt" /usr/local/bin/dolt && rm -rf "/tmp/${dolt_dir}"; fi'
  # headroom — LLM context-optimization CLI; the local ~/.claude/ settings
  # shipped to this box may reference it. Needs Python>=3.10 but AL2023's
  # system python3 is 3.9, so install a separate pinned python3.12 + isolated
  # venv rather than touch the system interpreter.
  - 'dnf install -y -q python3.12 python3.12-pip >/dev/null 2>&1 && python3.12 -m venv /opt/headroom-venv && /opt/headroom-venv/bin/pip install -q --no-cache-dir headroom-ai && ln -sf /opt/headroom-venv/bin/headroom /usr/local/bin/headroom'
  # rtk (Rust Token Killer) — token-optimized CLI proxy the local Claude
  # session's hooks shell out to for every bash command (~/.claude/RTK.md
  # shipped to this box documents the hook). v0.45.0 pinned. No prebuilt
  # aarch64 binary works here: the published gnu build needs glibc>=2.39,
  # AL2023 ships 2.34, and no aarch64-musl build is published. Build from
  # source instead via AL2023's own dnf-packaged rust/cargo — measured ~6min
  # added to first boot, LTO release build on a t4g.xlarge.
  - 'dnf install -y -q cargo rust >/dev/null 2>&1 && cd /tmp && curl -sL -o rtk-src.tar.gz "https://github.com/rtk-ai/rtk/archive/refs/tags/v0.45.0.tar.gz" && tar xzf rtk-src.tar.gz && cd rtk-0.45.0 && cargo build --release -q && install -m 0755 target/release/rtk /usr/local/bin/rtk && cd /tmp && rm -rf rtk-src.tar.gz rtk-0.45.0'
  # Run repo bootstrap (handles ownership + clone + compose up)
  - bash /usr/local/bin/rc-dev-bootstrap.sh
  # Start claude in a tmux session so user attaches into a ready agent
  # tmux 3.2a (what AL2023 ships) SEGFAULTS the whole server in
  # tty_set_selection when a clipboard write reaches a client whose terminal
  # advertises Ms (OSC-52). The only workaround on 3.2a is to strip Ms — which
  # is the very capability that makes copy-to-local-clipboard work over SSH, so
  # sessions survive but nothing can be copied out of them. Build a tmux that
  # does not have the bug; rc-dev-start-claude.sh enables the clipboard when it
  # sees >= 3.3 and falls back to Ms-stripping safe mode if this build failed.
  # Adds ~2-4 min to bootstrap.
  - 'if [ ! -x /usr/local/bin/tmux ]; then dnf install -y -q gcc make libevent-devel ncurses-devel bison >/dev/null 2>&1 && cd /tmp && curl -sSL -o tmux.tgz https://github.com/tmux/tmux/releases/download/3.5a/tmux-3.5a.tar.gz && tar xzf tmux.tgz && cd tmux-3.5a && ./configure --prefix=/usr/local >/dev/null 2>&1 && make -j"$(nproc)" >/dev/null 2>&1 && make install >/dev/null 2>&1; fi; /usr/local/bin/tmux -V 2>/dev/null || echo "tmux 3.5a build unavailable - falling back to system tmux (clipboard disabled)"'
  - sudo -u ec2-user /usr/local/bin/rc-dev-start-claude.sh
